# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce_test"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate each with: openssl rand -hex 64
# (left empty on purpose: the API refuses to start until these are set)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@yourstore.com"

# App URLs
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3001"
API_PORT=4000
# PORT is injected by hosts like Render and overrides API_PORT when set
# Reverse-proxy hops in front of the API (default: 1 in production, 0 otherwise)
# TRUST_PROXY=1
